# Скопируйте этот файл в .env на сервере и заполните значения.
# Файл .env в git не попадает.

# SMTP Яндекса / Mail.ru / своего хостера. Пароль приложения, не пароль от входа.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=заявки@ваш-домен.ru
SMTP_PASS=
SMTP_FROM=заявки@ваш-домен.ru

# Куда падают заявки (можно несколько адресов через запятую)
LEAD_MAIL_TO=info@ваш-домен.ru

# Порт, на котором работает Next.js за nginx
PORT=3001
